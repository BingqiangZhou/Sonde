# =============================================================================
# Docker 环境配置示例 / Docker Environment Configuration Example
# =============================================================================
# 使用方法 / Usage:
#   1. 复制此文件为 .env / Copy this file to .env
#   2. 根据需要修改配置 / Modify configuration as needed
#   3. 运行 / Run: docker compose up -d

# =============================================================================
# ============ 项目配置 / Project Configuration ============
# =============================================================================
# Compose project name is pinned to "sonde" in docker-compose.yml (name: sonde)

# =============================================================================
# ============ 端口配置 / Port Configuration ============
# =============================================================================
# Caddy 端口（标准生产端口）/ Caddy ports (standard production ports)
HTTP_PORT=80
HTTPS_PORT=443

# 后端端口（可对外直连调试；生产可留空改为仅经 Caddy 访问）
# Backend port (direct access for debugging; leave empty in production)
BACKEND_PUBLISH_PORT=8000

# 数据库端口（生产环境不暴露）/ Database port (not exposed in production)
DB_PORT=

# 数据库端口（暴露用于本地工具连接）/ Database port (for local tooling)
# DB_PORT=127.0.0.1:5432

# =============================================================================
# ============ 数据库配置 / Database Configuration ============
# =============================================================================
POSTGRES_DB=sonde
POSTGRES_USER=admin
# ⚠️ 必须修改为安全密码 / MUST CHANGE to secure password
POSTGRES_PASSWORD=MySecurePass2024!

# =============================================================================
# ============ 后端配置 / Backend Configuration ============
# =============================================================================
BACKEND_SRC_DIR=../backend
BACKEND_ENV_FILE=../backend/.env
# 云端使用 uvicorn 多 worker 提高性能
# Cloud: uvicorn with multiple workers for better performance
BACKEND_CMD=gunicorn app.main:app --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --workers 4 --timeout 120 --log-level info

# 队列 worker 并发数（转写任务较重，默认 1）
# Queue worker concurrency (transcription is heavy; default 1)
WORKER_CONCURRENCY=1

# Observability alert thresholds
OBS_ALERT_API_P95_MS=800
OBS_ALERT_API_ERROR_RATE=0.05
OBS_ALERT_DB_POOL_OCCUPANCY_RATIO=0.9

# =============================================================================
# ============ Caddy 配置 / Caddy Configuration ============
# =============================================================================
CADDY_CONF_DIR=./caddy

# 站点域名：localhost（默认）/ 内网 IP / 公网域名
# Site address: localhost (default) / LAN IP / public domain
DOMAIN=localhost

# 请求体大小上限（上传音频等）/ Request body size limit
MAX_BODY_SIZE=20MB

# 仅 ACME 模式使用（公网域名 + 80/443 可达时在 Caddyfile 中启用 tls <邮箱>）
# ACME mode only (public domain, ports 80/443 reachable)
ACME_EMAIL=

# =============================================================================
# ============ 存储路径配置 / Storage Path Configuration ============
# =============================================================================
LOG_DIR=./logs
TRANSCRIPTION_TEMP_DIR=./temp/transcription
TRANSCRIPTION_STORAGE_DIR=./storage/podcasts

# =============================================================================
# ============ 调试配置 / Debug Configuration ============
# =============================================================================
DEBUG_CONFIG=false
TZ=Asia/Shanghai
