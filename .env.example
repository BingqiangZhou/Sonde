# ── Postgres ────────────────────────────────────────────────
# 本地开发：本机 5432；Docker compose 内由 service 覆盖为 db:5432
POSTGRES_PASSWORD=sonde
DATABASE_URL=postgres://sonde:sonde@localhost:5432/sonde

# ── LLM（OpenAI 兼容 /chat/completions）─────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── 转写（OpenAI 兼容 /audio/transcriptions，如 SiliconFlow）──
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# ── 服务端口 / 地址 ─────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
# web 进程访问 api 的内网地址（Docker 内为 http://api:3001）
API_URL=http://localhost:3001
SITE_URL=http://localhost:3000

# ── Admin 后台 ──────────────────────────────────────────────
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Worker ──────────────────────────────────────────────────
WORK_CONCURRENCY=2

# ── 杂项 ────────────────────────────────────────────────────
REPORT_TIMEZONE=Asia/Shanghai
DATA_DIR=./data

# ── 播客发现（iTunes Search API）────────────────────────────
# 发现页搜索/榜单使用的国家商店码，逗号分隔（如 CN,US,TW,HK）
ITUNES_COUNTRIES=CN,US
# 可选：iTunes 客户端专用 DNS（如 1.1.1.1，取 Apple 全球 CDN）。
# 部分 Linux 容器/NAT 环境下国内 CDN 边缘会重置连接，配此项可规避；留空则用系统默认。
ITUNES_DNS=
# 可选：iTunes 客户端专用 HTTP 代理（容器内访问宿主机代理可写 http://host.docker.internal:7897）。
# 设置后 ITUNES_DNS 被忽略（解析交给代理）。留空 = 直连。
ITUNES_PROXY_URL=
