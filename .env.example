# ── Postgres ────────────────────────────────────────────────
# 本地开发：本机 5432；Docker compose 内由 service 覆盖为 db:5432
POSTGRES_PASSWORD=sonde
DATABASE_URL=postgres://sonde:sonde@localhost:5432/sonde

# ── 服务端口 / 地址 ─────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
# web 进程访问 api 的内网地址（Docker 内为 http://api:3001）
API_URL=http://localhost:3001
SITE_URL=http://localhost:3000
