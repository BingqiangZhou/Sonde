# ── Postgres ────────────────────────────────────────────────
# 本地开发：本机 5432；Docker compose 内由 service 覆盖为 db:5432
POSTGRES_PASSWORD=sonde
DATABASE_URL=postgres://sonde:sonde@localhost:5432/sonde

# ── LLM（OpenAI 兼容 /chat/completions）─────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── 转写（OpenAI 兼容 /audio/transcriptions，如 SiliconFlow）──
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# ── 服务端口 / 地址 ─────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
# web 进程访问 api 的内网地址（Docker 内为 http://api:3001）
API_URL=http://localhost:3001
SITE_URL=http://localhost:3000

# ── Admin 后台 ──────────────────────────────────────────────
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Worker ──────────────────────────────────────────────────
WORK_CONCURRENCY=2

# ── 杂项 ────────────────────────────────────────────────────
REPORT_TIMEZONE=Asia/Shanghai
DATA_DIR=./data
